//  Calcul de la catégorie de ménage auto dans le formulaire
async function calculerCategorieMenage(executionContext) {
    const formContext = executionContext.getFormContext();

    const anneeLookup = formContext.getAttribute("er_anneedesai")?.getValue();
    const nbPersonnes = formContext.getAttribute("er_totalnombredepersonnes")?.getValue();
    const revenu = formContext.getAttribute("er_totalrevenufiscaldereference")?.getValue();
    const champCategorie = formContext.getAttribute("er_categoriemenagetotai");


    console.log("Valeurs du formulaire :", {
        anneeLookup,
        nbPersonnes,
        revenu
    });


    // Si une info est manquante, on efface la catégorie
    if (!anneeLookup || nbPersonnes == null || revenu == null) {
        champCategorie.setValue(null);
        return;
    }

    const anneeNom = anneeLookup[0].name;
    const anneeNumerique = parseInt(anneeNom);
    if (isNaN(anneeNumerique)) {
        champCategorie.setValue(null);
        return;
    }

    try {
        // Requête vers la table des seuils
        const seuilsQuery = `?$filter=_er_anneeseuilanah_value eq '${anneeLookup[0].id.replace(/[{}]/g, "")}'`;
        const seuilsResult = await Xrm.WebApi.retrieveMultipleRecords("er_seuils_anah", seuilsQuery);
        const seuils = seuilsResult.entities;

        console.log("Seuils récupérés :", seuils);
        
        // Si aucun seuil n'est trouvé pour l'année, on efface la catégorie et affiche une alerte
        if (seuils.length === 0) {
            console.warn("Aucun seuil trouvé pour l'année sélectionnée :", anneeNom);
            champCategorie.setValue(null);

            Xrm.Navigation.openAlertDialog({
                text: "Aucun seuil n’a été trouvé pour l’année sélectionnée. Veuillez contacter votre responsable.",
                confirmButtonLabel: "OK"
            });

            return;
        }

        // Recherche des seuils normaux et supplémentaires
        const seuilNormal = seuils.find(s =>
            s["er_nbredepersonnes@OData.Community.Display.V1.FormattedValue"] === nbPersonnes.toString()
        );

        const seuilSup = seuils.find(s =>
            s["er_nbredepersonnes@OData.Community.Display.V1.FormattedValue"]?.toLowerCase().includes("suppl")
        );

        console.log("Seuil normal trouvé :", seuilNormal);
        console.log("Seuil supplémentaire trouvé :", seuilSup);

        let tresModeste = seuilNormal?.er_debut_tres_modeste ?? 0;
        let modeste = seuilNormal?.er_debut_modeste ?? 0;
        let intermediaire = seuilNormal?.er_debut_intermediaire ?? 0;
        let superieur = seuilNormal?.er_debut_revenus_superieurs ?? Number.MAX_SAFE_INTEGER;

        // Si le nombre dépasse les seuils définis, extrapolation
        if (!seuilNormal && seuilSup) {
            const base = seuils.find(s =>
                s["er_nbredepersonnes@OData.Community.Display.V1.FormattedValue"] === "5"
            );
            const extra = nbPersonnes - 5;

            console.log("Base extrapolation :", base);
            console.log("Nombre de personnes supplémentaires :", extra);

            tresModeste = base.er_debut_tres_modeste + extra * seuilSup.er_debut_tres_modeste;
            modeste = base.er_debut_modeste + extra * seuilSup.er_debut_modeste;
            intermediaire = base.er_debut_intermediaire + extra * seuilSup.er_debut_intermediaire;
            superieur = base.er_debut_revenus_superieurs + extra * seuilSup.er_debut_revenus_superieurs;
        }

        console.log("Seuils utilisés pour le calcul :", {
            tresModeste,
            modeste,
            intermediaire,
            superieur
        });

        // Détermination de la catégorie par tranche
        let valeurChoix = 122210000; // Aux revenus supérieurs
        if (revenu <= modeste) valeurChoix = 122210003; // Très Modeste
        else if (revenu <= intermediaire) valeurChoix = 122210002; // Modeste
        else if (revenu <= superieur) valeurChoix = 122210001; // Intermédiaire

        console.log("Catégorie déterminée :", valeurChoix);

        champCategorie.setValue(valeurChoix);
    } catch (error) {
        console.error("Erreur lors du calcul de la catégorie de ménage :", error);
        champCategorie.setValue(null);
    }
}


