//  Mettre en lecture seule si statut de l'appel est "Résolu" + Mettre la date de résolution et Nom de la personne qui a résolu l'appel
function ModeLectureSeuleChampAppels(executionContext) {
    var formContext = executionContext.getFormContext();
    var statut = formContext.getAttribute("er_statutdelappel").getValue();  // Récupère le statut de l'appel

    var isReadOnly = (statut === 122210001);                                // 122 210 001 = Résolu

    var attributes = formContext.data.entity.attributes.get();

    attributes.forEach(function (attribute) {
        var name = attribute.getName();
        var control = formContext.getControl(name);

        // Ne pas désactiver le champ Statut
        if (control && name !== "er_statutdelappel") {                      // Pour ne pas verrouiller le champ "statut de l'appel"
            control.setDisabled(isReadOnly);
        }
    });

    // Si le statut est "Résolu", mettre à jour les champs associés
    if (isReadOnly) {
        // Mettre à jour la date de résolution
        var dateResolutionAttr = formContext.getAttribute("er_dateheurederesolution");
        if (dateResolutionAttr) {
            dateResolutionAttr.setValue(new Date());
        }

        // Mettre à jour le champ "Résolu par" avec l'utilisateur actuel
        var userId = Xrm.Utility.getGlobalContext().userSettings.userId;
        var resolvedByAttr = formContext.getAttribute("er_resolupar");
        if (resolvedByAttr) {
            resolvedByAttr.setValue([
                {
                    id: userId,
                    entityType: "systemuser"
                }
            ]);
        }
    } else {
        // Si le statut n'est plus "Résolu", effacer les champs :
        formContext.getAttribute("er_dateheurederesolution").setValue(null);
        formContext.getAttribute("er_resolupar").setValue(null);
    }
}

// Création d'un enregistrement dans la table de jonction ContactMénage(N:N) : Permet d'enregistrer un contact pour un ménage
function CreationContactMenageOnFieldChangeOrSave(executionContext) {
    try {
        var formContext = executionContext.getFormContext();
        //console.log("✅ Script démarré");                          // A utiliser pour debogage

        var direction = formContext.getAttribute("directioncode");  // true = sortant, false = entrant
        var menageField = formContext.getAttribute("new_menage");   // Récupère le champ de type Lookup vers la table Ménage

        if (!direction || !menageField) {
            //console.log("❌ direction ou ménage non trouvé");
            return;
        }

        var isSortant = direction.getValue();                       // true = sortant, false = entrant
        //console.log("📞 Type d'appel : " + (isSortant ? "Sortant" : "Entrant"));

        var contactField = isSortant
            ? formContext.getAttribute("to")                        // Si sortant, le champ "to" (destination)
            : formContext.getAttribute("from");                     // Si entrant, le champ "from" (origine)

        if (!contactField || !contactField.getValue()) {
            //console.log("❌ Champ contact vide");
            return;
        }

        if (!menageField.getValue()) {
            //console.log("❌ Champ ménage vide");
            return;
        }

        var contact = contactField.getValue()[0];
        var menage = menageField.getValue()[0];

        //console.log("👤 Entité contact : " + contact.entityType);
        if (contact.entityType !== "contact") {
            //console.log("❌ L'entité n'est pas un contact");
            return;
        }

        var contactId = contact.id.replace(/[{}]/g, "");
        var menageId = menage.id.replace(/[{}]/g, "");

        //console.log("🔍 Contact ID : " + contactId);
        //console.log("🏠 Ménage ID : " + menageId);

        // Vérifier si la relation existe déjà
        
        var filter = `?$filter=_er_contact_value eq ${contactId} and _er_menage_value eq ${menageId}`;
        //console.log("🔎 Requête OData corrigée : " + filter);
        Xrm.WebApi.retrieveMultipleRecords("er_contactmenage", filter).then(

            function success(result) {
                //console.log("📊 Résultat de la requête : " + result.entities.length);

                if (result.entities.length === 0) {
                    //console.log("➕ Aucune relation trouvée, création en cours...");

                    var data = {
                        "er_Contact@odata.bind": `/contacts(${contactId})`,
                        "er_Menage@odata.bind": `/er_menages(${menageId})`
                    };

                    Xrm.WebApi.createRecord("er_contactmenage", data).then(
                        function success(createResult) {
                            console.log("✅ Relation créée : " + createResult.id);
                        },
                        function (error) {
                            console.error("❌ Erreur lors de la création : " + error.message);
                        }
                    );
                } else {
                    console.log("ℹ️ Relation déjà existante, aucune action nécessaire.");
                }
            },
            function (error) {
                console.error("❌ Erreur lors de la vérification de la relation : " + error.message);
            }
        );
    } catch (e) {
        console.error("❌ Erreur générale dans le script : " + e.message);
    }
}



