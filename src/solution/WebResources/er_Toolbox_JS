//  Variable globale pour sauvegarder To
var lastTo = null;

//  Fonction OnLoad du formulaire
function onLoad(executionContext) {
    var formContext = executionContext.getFormContext();

    // Initialisation de lastTo si direction est sortante
    var direction = formContext.getAttribute("directioncode").getValue();
    if (direction === true) {
        lastTo = formContext.getAttribute("to").getValue();
    }

    toggleFromVisibility(formContext, direction);   // Permet de gérer la visibilité du champ Origine de l'appel
    
    // Enregistrement des événements
    formContext.getAttribute("directioncode").addOnChange(onDirectionChange);
    formContext.getAttribute("to").addOnChange(onToChange);
    formContext.getAttribute("er_appelant").addOnChange(onAppelantChange);
}

//  Si changement de direction. Entrant : From = appelant et Appelant = LastTo, Sortant : Sauvegarde de To dans LastTo et vide le champ Appelant
function onDirectionChange(executionContext) {
    var formContext = executionContext.getFormContext();
    var direction = formContext.getAttribute("directioncode").getValue();
    var appelantAttr = formContext.getAttribute("er_appelant");
    var fromAttr = formContext.getAttribute("from");
    var toAttr = formContext.getAttribute("to");

    toggleFromVisibility(formContext, direction);   // Permet de gérer la visibilité du champ Origine de l'appel
    

    if (direction === false) { // fasle = entrant, true = sortant
        // Direction = Entrant
        var appelant = appelantAttr.getValue();
        if (appelant) {
            fromAttr.setValue(appelant);
        }

        // Récupérer lastTo dans Appelant si disponible
        if (lastTo) {
            appelantAttr.setValue(lastTo);
        }
    } else {
        // Direction = Sortant
        lastTo = toAttr.getValue(); // Sauvegarde de to
        appelantAttr.setValue(null); // Effacer Appelant
    }
}

//  Si changment de direction: Sauvegarde To dans LastTo
function onToChange(executionContext) {
    var formContext = executionContext.getFormContext();
    var direction = formContext.getAttribute("directioncode").getValue();

    if (direction === true) {
        // Direction = Sortant → mise à jour de lastTo
        lastTo = formContext.getAttribute("to").getValue();
    }
}

//  Si changement de l'appelant, From = Appelant
function onAppelantChange(executionContext) {
    var formContext = executionContext.getFormContext();
    var direction = formContext.getAttribute("directioncode").getValue();

    if (direction === false) {
        var appelant = formContext.getAttribute("er_appelant").getValue();
        formContext.getAttribute("from").setValue(appelant);
    }
}

// 🔧 Fonction utilitaire pour afficher/masquer le champ "from"
function toggleFromVisibility(formContext, direction) {
    var fromControl = formContext.getControl("from");
    if (fromControl) {
        fromControl.setVisible(direction === true); // Affiche si sortant
    }
}

