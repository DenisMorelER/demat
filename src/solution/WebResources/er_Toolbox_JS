    // Fonction principale appelée au chargement du formulaire
    async function onLoad(executionContext) {
        const formContext = executionContext.getFormContext();

        // Chargement des correspondances de choix depuis Dataverse
        await chargerCorrespondancesChoix();

        // Gestion du champ de recherche d'adresse
        const rechercheField = formContext.getAttribute(rechercheAttribute);
        if (rechercheField) {
            rechercheField.addOnChange(() => {
                const value = rechercheField.getValue();
                if (value && value.length >= 4) {
                    if (debounceTimer) clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        fetchSuggestions(value, formContext);
                    }, 200);
                }
            });
        }

        // Gestion du champ de sélection d'adresse
        const selectionField = formContext.getAttribute(selectionAttribute);
        if (selectionField) {
            selectionField.addOnChange(() => {
                const selected = selectionField.getValue();

                // Liste des champs remplis automatiquement
                const champsAuto = [
                    latitudeAttribute, longitudeAttribute, parcelleAttribute,
                    idAttribute, numeroAttribute, repAttribute, nomVoieAttribute,
                    codePostalAttribute, communeAttribute, acheminementAttribute, nomAfnorAttribute
                ];

                if (!selected) {
                    // Si aucune adresse sélectionnée : réinitialiser et déverrouiller les champs
                    champsAuto.forEach(attr => {
                        const field = formContext.getAttribute(attr);
                        field?.setValue(null);
                        field?.controls?.forEach(c => c.setDisabled(false));
                    });
                    return;
                }

                // Si une adresse est sélectionnée : remplir et verrouiller les champs
                const match = suggestionsCache.find(s => s.label === selected);
                if (match) {
                    formContext.getAttribute(latitudeAttribute)?.setValue(match.lat);
                    formContext.getAttribute(longitudeAttribute)?.setValue(match.lon);
                    formContext.getAttribute(parcelleAttribute)?.setValue(String(match.parcelle || ""));
                    formContext.getAttribute(idAttribute)?.setValue(String(match.id || ""));
                    formContext.getAttribute(numeroAttribute)?.setValue(match.numero);
                    formContext.getAttribute(nomVoieAttribute)?.setValue(String(match.nom_voie || ""));
                    formContext.getAttribute(nomAfnorAttribute)?.setValue(String(match.nom_afnor || ""));

                    // Remplissage des champs de type choix via cache
                    setValeurChampDepuisCache(formContext, repAttribute, match.indice_repetition, "Indice de répétition");
                    setValeurChampDepuisCache(formContext, codePostalAttribute, match.code_postal, "Code Postal");
                    setValeurChampDepuisCache(formContext, communeAttribute, match.ville, "Commune");
                    setValeurChampDepuisCache(formContext, acheminementAttribute, match.libelledacheminement, "Libellé d'acheminement");

                    // Verrouillage des champs remplis automatiquement
                    champsAuto.forEach(attr => {
                        const field = formContext.getAttribute(attr);
                        field?.controls?.forEach(c => c.setDisabled(true));
                    });
                }
            });
        }
    }

    // Fonction pour charger toutes les correspondances de choix en une seule requête
        function escapeODataValue(value) {
        return value.replace(/'/g, "''");
    }

    async function chargerCorrespondancesChoix() {
        const filters = "(" + choixChamps
            .map(champ => `crfc6_nomchamp eq '${escapeODataValue(champ)}'`)
            .join(" or ") + ")";
        const entite = escapeODataValue(nomEntite);
        const query = `crfc6_correspondancechoixes?$filter=${filters} and crfc6_nomentite eq '${entite}'&$select=crfc6_libelle,crfc6_nomchamp,crfc6_valeur`;

        const url = `${Xrm.Utility.getGlobalContext().getClientUrl()}/api/data/v9.2/${query}`;
        console.log("🔗 URL Dataverse générée :", url);

        const response = await fetch(url, {
            headers: {
                "OData-MaxVersion": "4.0",
                "OData-Version": "4.0",
                "Accept": "application/json",
                "Content-Type": "application/json; charset=utf-8",
                "Prefer": "odata.include-annotations=*"
            }
        });

        if (response.ok) {
            const data = await response.json();
            console.log("✅ Réponse reçue :", data);
            data.value.forEach(item => {
                const champ = item.crfc6_nomchamp;
                const libelle = item.crfc6_libelle;
                const valeur = item.crfc6_valeur;
                if (!choixCache[champ]) choixCache[champ] = {};
                choixCache[champ][libelle] = valeur;
            });
        } else {
            const errorText = await response.text();
            console.error("❌ Erreur API Dataverse :", response.status, response.statusText, errorText);
        }
    }


    // Fonction utilitaire pour renseigner un champ de type choix à partir du cache
    function setValeurChampDepuisCache(formContext, champLogique, libelle, nomChamp) {
        const valeur = choixCache[nomChamp]?.[libelle] ?? null;
        formContext.getAttribute(champLogique)?.setValue(valeur);
    }

    // Appel à l'API BAN pour récupérer les suggestions d'adresses
    function fetchSuggestions(query, formContext) {
        const url = apiUrl + encodeURIComponent(query) + "&rows=12";
        fetch(url)
            .then(response => response.json())
            .then(data => {
                suggestionsCache = [];
                if (data.records?.length > 0) {
                    data.records.forEach(record => {
                        const f = record.fields;
                        const label = `${f.numero || ""} ${f.rep || ""} ${f.nom_voie || ""}, ${f.code_postal || ""} ${f.libelle_acheminement || ""}, ${f.nom_commune || ""}`;
                        suggestionsCache.push({
                            label: label.trim(),
                            lat: f.lat ?? null,
                            lon: f.lon ?? null,
                            parcelle: f.cad_parcelles ?? "",
                            id: f.id ?? "",
                            numero: f.numero ?? "",
                            indice_repetition: f.rep ?? "",
                            nom_voie: f.nom_voie ?? "",
                            code_postal: f.code_postal ?? "",
                            ville: f.nom_commune ?? "",
                            libelledacheminement: f.libelle_acheminement ?? "",
                            nom_afnor: f.nom_afnor ?? ""
                        });
                    });
                }
                updateDropdown(formContext);
            });
    }

    // Mise à jour du champ de propositions avec les libellés des suggestions
    function updateDropdown(formContext) {
        const propositionsField = formContext.getAttribute(propositionsAttribute);
        if (propositionsField?.setValue) {
            const values = suggestionsCache.map(s => s.label);
            propositionsField.setValue("");
            propositionsField.setValue(values.join(";"));
        }
    }

    // Export de la fonction onLoad
    return {
        onLoad: onLoad
    };
})();




