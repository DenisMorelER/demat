                const attributeName = attribute.LogicalName;
                const attributeDisplayName = attribute.DisplayName?.UserLocalizedLabel?.Label ?? attributeName;
                console.log(`   🔸 Champ choix : ${attributeDisplayName} (${attributeName})`);

                const optionsUrl = `${clientUrl}/api/data/v9.2/EntityDefinitions(LogicalName='${entityName}')/Attributes(LogicalName='${attributeName}')/Microsoft.Dynamics.CRM.PicklistAttributeMetadata?$select=LogicalName&$expand=OptionSet`;
                const metadata = await fetchJson(optionsUrl);
                const options = metadata.OptionSet.Options;

                for (const option of options) {
                    const label = option.Label?.UserLocalizedLabel?.Label ?? "(Sans étiquette)";
                    const value = option.Value;
                    console.log(`      🏷️ Option : ${label} (${value})`);

                    const checkUrl = `${clientUrl}/api/data/v9.2/crfc6_correspondancechoixes?$filter=er_nomlogiquechamp eq '${attributeName}' and crfc6_valeur eq ${value}`;
                    const existing = (await fetchJson(checkUrl)).value;

                    const payload = {
                        crfc6_nomchamp: attributeDisplayName,
                        er_nomlogiquechamp: attributeName,
                        crfc6_nomentite: entityDisplayName,
                        er_nomlogiqueentite: entityName,
                        crfc6_valeur: value,
                        crfc6_libelle: label,
                        er_choixtoujouractif: true
                    };

                    if (existing.length > 0) {
                        const record = existing[0];
                        const patchUrl = `/api/data/v9.2/crfc6_correspondancechoixes(${record.crfc6_correspondancechoixid})`;
                        batchOperations.push({ method: "PATCH", url: patchUrl, payload });
                    } else {
                        const postUrl = `/api/data/v9.2/crfc6_correspondancechoixes`;
                        batchOperations.push({ method: "POST", url: postUrl, payload });
                    }
                }
            }
        }

        // Étape 3 : Envoi du batch
        console.time("⏱️ Batch");
        await sendBatchRequest(batchOperations, clientUrl);
        console.timeEnd("⏱️ Batch");

        console.log("✅ Synchronisation terminée !");
        console.timeEnd("⏱️ Total");
    }

