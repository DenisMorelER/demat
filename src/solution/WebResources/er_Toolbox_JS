//  DEPRECATED! Replaced by an n:n relationship and a flow to calculate each hour the number of visit per dispositive
function setConcatenatedChoices(executionContext) {
    var formContext = executionContext.getFormContext();

    // Replace with your actual field names
    var multiSelectField = "er_objet_visite"; 
    var textField = "er_objet_visite_string"; 

    var choiceValues = formContext.getAttribute(multiSelectField).getValue();
    
    if (choiceValues !== null && choiceValues.length > 0) {
        // Retrieve all available options for the field
        var options = formContext.getAttribute(multiSelectField).getOptions();
        
        // Convert numeric values to corresponding labels
        var selectedLabels = choiceValues.map(value => {
            var option = options.find(opt => opt.value === value);
            return option ? option.text : value; // Use value as fallback
        });

        // Join values and set them in the text field
        var concatenatedValues = selectedLabels.join(", ");
        formContext.getAttribute(textField).setValue(concatenatedValues);
    } else {
        formContext.getAttribute(textField).setValue(""); // Clear if empty
    }
    formContext.data.refresh(true);
}


